# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# legacy archives site: only ship what the /archives/* pages actually use.
# These folders are unreferenced backups or media for legacy HTML pages that
# have been replaced by Next routes (/ddb, /flv, /vision). Keeping them out
# stays under GitHub's 100 MB file limit and avoids ~1 GB of repo bloat.
public/archives/.claude/
public/archives/assets/img/ddb/
public/archives/assets/img/visio/
public/archives/assets/img/flv/
public/archives/assets/img/obg/backup_full/
public/archives/assets/img/webd/backup/

# typescript
*.tsbuildinfo
next-env.d.ts
